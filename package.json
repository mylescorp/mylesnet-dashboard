{
  "name": "mylesnet-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:https": "node https-dev.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"convex/lib/*.test.ts\"",
    "collector:start": "node --env-file-if-exists=collector/.env.local collector/forwarder.mjs",
    "collector:check": "node --env-file-if-exists=collector/.env.local collector/forwarder.mjs --once",
    "collector:local": "powershell -ExecutionPolicy Bypass -File collector/run-local.ps1",
    "collector:local:check": "powershell -ExecutionPolicy Bypass -File collector/run-local.ps1 -Once"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/workos": "^0.0.3",
    "@convex-dev/workos-authkit": "^0.2.9",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/authkit-react": "^0.16.2",
    "convex": "^1.44.0",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
