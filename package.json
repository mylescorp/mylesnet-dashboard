{
  "name": "mylesnet-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mylesnet/web run dev",
    "build": "pnpm --filter @mylesnet/web run build",
    "start": "pnpm --filter @mylesnet/web run start",
    "lint": "pnpm --filter @mylesnet/web run lint",
    "typecheck": "pnpm --filter @mylesnet/web run typecheck",
    "tokens:check": "pnpm --filter @mylesnet/web run tokens:check",
    "landing:check": "node scripts/check-landing-routes.mjs",
    "test": "node --test convex/lib/*.test.ts apps/web/shared/**/*.test.ts",
    "test:ui": "pnpm --filter @mylesnet/web run test"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.95",
    "convex": "~1.44.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "turbo": "^2",
    "typescript": "^5"
  }
}
