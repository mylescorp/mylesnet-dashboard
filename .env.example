# Convex Configuration
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOY_KEY=your_convex_deploy_key

# Convex Auth Configuration
AUTH_SECRET=your_auth_secret_key_generate_with_openssl_rand_base64_32
CONVEX_SITE_URL=https://your-domain.com
# Base64-encoded 32-byte AES-256 key. Generate and store it only in the
# deployment environment, never in source control.
ROUTER_CREDENTIALS_ENCRYPTION_KEY=
# Base64-encoded 32-byte AES-256 key used to encrypt the Centipid MCP token and
# webhook signing secret before they are persisted. Same generation rule as above.
CENTIPID_CREDENTIALS_ENCRYPTION_KEY=
MYLESNET_COLLECTOR_SHARED_SECRET=

# WorkOS AuthKit Configuration
WORKOS_CLIENT_ID=client_your_client_id_here
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_COOKIE_PASSWORD=your_secure_password_here_must_be_at_least_32_characters_long
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://localhost:3000/auth/callback
MYLESNET_PLATFORM_ORG_ID=
MYLESNET_BOOTSTRAP_OWNER_EMAILS=

# Router Configuration (for development testing)
# ROUTER_BASE_URL=https://192.168.1.1:8443
# ROUTER_USERNAME=monitoring_account
# ROUTER_PASSWORD=monitoring_password

# The Centipid MCP bearer token (format 12|...) is used ONLY by the opencode MCP
# client on the operator's machine. It is never read by the app and must not be
# committed. The app itself receives the token via the Centipid settings page,
# where it is encrypted with CENTIPID_CREDENTIALS_ENCRYPTION_KEY and stored in
# the database. The webhook signing secret is entered the same way; webhook
# deliveries are verified against it before any event is stored.
