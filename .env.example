# Convex Configuration
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOY_KEY=your_convex_deploy_key
# Convex deployment slug used by convex deploy in CI. Canonical production:
# precious-chipmunk-720 (see Master Final Document Control).
CONVEX_DEPLOYMENT=your_production_convex_deployment_slug
# Canonical production Convex HTTP origin. Public value, matches the Master
# Final Document Control.
NEXT_PUBLIC_CONVEX_PRODUCTION_URL=https://precious-chipmunk-720.convex.cloud
# Convex site origin used for function invocation. Development uses
# https://127.0.0.1:3211.
NEXT_PUBLIC_CONVEX_SITE_URL=your_convex_site_url

# Convex Auth Configuration
AUTH_SECRET=your_auth_secret_key_generate_with_openssl_rand_base64_32
CONVEX_SITE_URL=https://your-domain.com
# Base64-encoded 32-byte AES-256 key. Generate and store it only in the
# deployment environment, never in source control.
ROUTER_CREDENTIALS_ENCRYPTION_KEY=base64_32_byte_key_placeholder_router
# Base64-encoded 32-byte AES-256 key used to encrypt the Centipid MCP token and
# webhook signing secret before they are persisted. Same generation rule as above.
CENTIPID_CREDENTIALS_ENCRYPTION_KEY=base64_32_byte_key_placeholder_centipid
MYLESNET_COLLECTOR_SHARED_SECRET=your_collector_shared_secret_placeholder

# Public company contact details (Contact Page Standards)
# Real values from the deployment environment only; never committed. Used by the
# public landing get-started and contact surfaces.
NEXT_PUBLIC_COMPANY_INFO_EMAIL=
NEXT_PUBLIC_COMPANY_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_SALES_EMAIL=
NEXT_PUBLIC_COMPANY_TECHNICAL_PHONE=
NEXT_PUBLIC_COMPANY_SALES_PHONE=

# Canonical public origin of the site. Drives metadataBase, canonical URLs,
# sitemap.xml, robots.txt, and JSON-LD. Public value (not a secret); set per
# environment — localhost locally, the production host in the deployment env.
# Unset falls back to the production URL in app/(landing)/content/seo.ts.
NEXT_PUBLIC_SITE_URL=https://mylesnetisp.mylescorptech.com

# WorkOS AuthKit Configuration
WORKOS_CLIENT_ID=client_your_client_id_here
WORKOS_API_KEY=sk_test_your_api_key_here
WORKOS_COOKIE_PASSWORD=your_secure_password_here_must_be_at_least_32_characters_long
# Canonical production redirect URI. Local development overrides this in the
# untracked .env.local only; never commit the local value to .env.production.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://mylesnetisp.mylescorptech.com/auth/callback
# WorkOS application routes. Sign-up is app-hosted only as a safe handoff to
# AuthKit. Leave invitation and reset URLs unset unless custom handlers safely
# consume WorkOS invitation/password-reset tokens; AuthKit hosted defaults do.
NEXT_PUBLIC_WORKOS_SIGN_UP_URL=https://mylesnetisp.mylescorptech.com/signup
NEXT_PUBLIC_WORKOS_INVITATION_URL=https://mylesnetisp.mylescorptech.com/invite
NEXT_PUBLIC_WORKOS_PASSWORD_RESET_URL=https://mylesnetisp.mylescorptech.com/password-reset
NEXT_PUBLIC_WORKOS_INITIATE_LOGIN_URL=https://mylesnetisp.mylescorptech.com/login
MYLESNET_PLATFORM_ORG_ID=org_your_platform_org_id_here
MYLESNET_BOOTSTRAP_OWNER_EMAILS=owner@example.com,second_owner@example.com
# Signing secret of the WorkOS webhook endpoint that syncs identity events
# (user/invitation/membership/session changes) into Convex.
WORKOS_WEBHOOK_SECRET=your_workos_webhook_signing_secret
# Name of the AuthKit session cookie. Defaults to "wos-session" when unset.
WORKOS_COOKIE_NAME=wos-session
# Network (Super Admin) WorkOS organization id. Used to map panel orgs when the
# multi-panel/subdomain routing is enabled (AUTH backlog).
MYLESNET_NETWORK_ORG_ID=org_your_network_org_id_here
# Product-domain allow-list. Only the apex, canonical panel hosts, and one
# tenant label beneath this domain may initiate AuthKit flows.
MYLESNET_PUBLIC_DOMAIN=mylesnetisp.mylescorptech.com
# Keep unset. MylesNet cookies are intentionally host-only; a panel or tenant
# session must never be sent to a sibling subdomain.
MYLESNET_COOKIE_DOMAIN=
# Provisioned but data-dark until their independently approved modules launch.
NEXT_PUBLIC_ENABLE_AGENCY_PANEL=false
NEXT_PUBLIC_ENABLE_PARTNER_PANEL=false
# Mandatory-2FA enforcement overrides (Security Standards / RBAC shadow mode).
# Defaults: full enforcement. Set NEXT_PUBLIC_ENABLE_RBAC_SHADOW_MODE=true for
# log-only, or NEXT_PUBLIC_RBAC_ENFORCEMENT_LEVEL=off/partial to relax.
NEXT_PUBLIC_ENABLE_RBAC_SHADOW_MODE=false
NEXT_PUBLIC_RBAC_ENFORCEMENT_LEVEL=full

# Router Configuration (for development testing)
# ROUTER_BASE_URL=https://192.168.1.1:8443
# ROUTER_USERNAME=monitoring_account
# ROUTER_PASSWORD=monitoring_password

# The Centipid MCP bearer token (format 12|...) is used ONLY by the opencode MCP
# client on the operator's machine. It is never read by the app and must not be
# committed. The app itself receives the token via the Centipid settings page,
# where it is encrypted with CENTIPID_CREDENTIALS_ENCRYPTION_KEY and stored in
# the database. The webhook signing secret is entered the same way; webhook
# deliveries are verified against it before any event is stored.
CENTIPID_MCP_TOKEN=your_centipid_mcp_token_placeholder

# The Vercel OIDC token is fetched by the Vercel CLI during builds (values in
# the deployment environment only). It is not needed locally.
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_placeholder

# Ship rules: .env.example documents the contract. Real values live ONLY in the
# untracked .env.local and the configured deployment environments. Never commit
# secrets. Identifiers must match the Master Final Document Control identity
# block (Vercel https://vercel.com/mylescorp/mylesnet-dashboard, Convex prod
# precious-chipmunk-720, WorkOS MylesNet sandbox env, prod host mylesnetisp.mylescorptech.com).
