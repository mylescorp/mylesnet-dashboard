import { cronJobs } from "convex/server";

export default cronJobs({
  // Collect health data every 30 seconds
  collectHealthData: {
    schedule: "*/30 * * * * *",
    handler: "cron:collectHealthData",
  },
  // Collect usage data every 60 seconds
  collectUsageData: {
    schedule: "*/60 * * * * *",
    handler: "cron:collectUsageData",
  },
});
